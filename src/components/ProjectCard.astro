---
import type { CollectionEntry } from 'astro:content';
import Media from './Media.astro';
import { statusLabel, withBase } from '../data/site';

interface Props { project: CollectionEntry<'projects'>; index: number; }
const { project, index } = Astro.props;
const p = project.data;
---
<a
  class="card"
  href={withBase(`/proyectos/${project.id}/`)}
  data-tags={p.tags.join(',')}
  data-hover-video={p.video ? '' : undefined}
  style={`--i:${index}; view-transition-name: card-${project.id}`}
>
  <Media id={project.id} cover={p.cover} video={p.video} alt={p.title} eager={index < 2} />
  <div class="card-row">
    <h2 transition:name={`title-${project.id}`}>{p.title}</h2>
    <span class="year">{p.year}</span>
  </div>
  <p>{p.summary}</p>
  <span class="status" data-status={p.status}>{statusLabel[p.status]}</span>
</a>
